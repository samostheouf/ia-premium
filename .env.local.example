# ia-premium — Variables d'environnement
# ────────────────────────────────────────────────────────────
# Copier ce fichier vers .env.local, puis compléter les valeurs :
#
#     cp .env.local.example .env.local
#
# ⚠️  Les valeurs ci-dessous sont des PLACEHOLDERS. Elles ne fonctionneront pas :
#     les remplacer par les vraies clés issues du tableau de bord Stripe.
#     Ne jamais committer un .env.local (déjà ignoré par .gitignore).
# ────────────────────────────────────────────────────────────
#
# STRIPE — https://dashboard.stripe.com/apikeys
#   • Mode test       : sk_test_… / pk_test_…   (cartes de test, aucun argent réel)
#   • Mode production : sk_live_… / pk_live_…  (à n'activer qu'une fois le site
#     validé, avec le compte Stripe en organisme de paiement confirmé)
#
# Tant que STRIPE_SECRET_KEY est absente ou invalide, POST /api/checkout
# répond 503 et l'interface affiche un message d'indisponibilité clair
# (voir lib/checkout-client.ts et app/components/CTA.tsx).

# ─── Stripe (serveur) ───────────────────────────────────────────────────────
# Clé secrète : utilisée uniquement dans les API routes et les Server Components.
# Ne JAMAIS la préfixer par NEXT_PUBLIC_ ni l'exposer côté client.
# Sans cette clé, le paiement est indisponible.
STRIPE_SECRET_KEY=sk_test_VOTRE_CLE_SECRETE_ICI

# ─── Stripe (client) ────────────────────────────────────────────────────────
# Clé publiable : sûre pour le navigateur, limitée aux actions sans secret.
# Préfixe NEXT_PUBLIC_ requis pour qu'elle soit exposée au client.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_VOTRE_CLE_PUBLIQUE_ICI

# ─── URL de l'application ───────────────────────────────────────────────────
# Utilisée pour construire les redirections après paiement (success_url,
# cancel_url) ainsi que les URL canoniques et le sitemap.
# En production : https://ia-premium-chi.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Optionnel ──────────────────────────────────────────────────────────────
# Point de réception des événements de mesure d'audience (Analytics.tsx).
# Laisser vide pour n'effectuer aucun envoi réseau : les événements restent
# uniquement dans la console en développement.
# NEXT_PUBLIC_ANALYTICS_ENDPOINT=/api/analytics

# Identifiant de version affiché dans les journaux serveur.
APP_VERSION=0.1.0
