# ia-premium — Variables d'environnement Stripe
# ────────────────────────────────────────────────────────────
# Copier ce fichier vers .env.local et remplir vos clés
#
# Clés de test (mode test Stripe) :
#   STRIPE_SECRET_KEY=sk_test_...
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
#
# Pour passer en live, utiliser les clés production :
#   STRIPE_SECRET_KEY=sk_live_...
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
#
# URL de l'application (utilisée pour les redirections après paiement) :
#   NEXT_PUBLIC_APP_URL=http://localhost:3000
# ────────────────────────────────────────────────────────────

# Clé secrète Stripe (serveur uniquement — ne jamais exposer côté client)
# Utiliser sk_test_* pour les tests, sk_live_* pour la production
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Clé publique Stripe (côté client — exposée via NEXT_PUBLIC_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# URL de base de l'application (pour les redirections après paiement)
NEXT_PUBLIC_APP_URL=http://localhost:3000
